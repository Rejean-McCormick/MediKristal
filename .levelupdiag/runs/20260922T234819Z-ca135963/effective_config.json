{
  "schema": "levelupdiag.config.v2",
  "target_repo_root": "auto",
  "control_dir": ".levelupdiag",
  "execution": {
    "max_parallel": 4,
    "default_timeout_seconds": 180,
    "fail_fast": false,
    "capture_limit_kb": 256,
    "protect_tracked_files": true,
    "allow_target_mutation": false,
    "allow_network": false
  },
  "scan": {
    "exclude_dirs": [
      ".git",
      ".hg",
      ".svn",
      ".levelupdiag",
      "levelupdiag",
      "node_modules",
      "vendor",
      "dist",
      "build",
      "target",
      ".venv",
      "venv",
      "__pycache__",
      ".cache",
      "coverage",
      ".tox",
      ".mypy_cache",
      ".pytest_cache"
    ],
    "max_files": 20000,
    "max_file_bytes": 1048576,
    "max_security_files": 6000,
    "large_file_bytes": 10485760
  },
  "toolchain": {
    "required": [
      "python"
    ],
    "optional": [
      "node",
      "docker"
    ]
  },
  "validators": [
    {
      "id": "medikristal-pytest",
      "name": "MediKristal application test suite",
      "command": [
        "python",
        "-m",
        "pytest",
        "-q",
        "-p",
        "no:cacheprovider"
      ],
      "cwd": "backend",
      "required": true,
      "timeout_seconds": 900,
      "mutates_target": false,
      "network": false,
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "medikristal-frontend-js",
      "name": "MediKristal frontend JavaScript syntax",
      "command": [
        "node",
        "--check",
        "frontend/app.js"
      ],
      "cwd": ".",
      "required": true,
      "timeout_seconds": 120,
      "mutates_target": false,
      "network": false
    }
  ],
  "security": {
    "enabled": true,
    "scan_untracked": false,
    "additional_patterns": [],
    "additional_excluded_globs": [
      "source-snapshots.json"
    ]
  },
  "redaction": {
    "enabled": true,
    "replacement": "<REDACTED>"
  },
  "medikristal": {
    "expected_project_name": "medikristal",
    "expected_version": "0.2.0",
    "expected_operations": 80,
    "expected_schemas": 107,
    "expected_examples": 12,
    "expected_chapters": 33,
    "expected_requirements": 32,
    "expected_tests": 73,
    "minimum_global_coverage_percent": 90,
    "required_external_capability_states": {
      "provider_network": [
        "unavailable",
        "not_configured"
      ],
      "fhir_partner": [
        "unavailable",
        "not_configured"
      ],
      "kristal_export": [
        "unavailable",
        "not_configured"
      ]
    }
  }
}
